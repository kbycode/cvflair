include LICENSE
include README.md
include README.tr.md
include CHANGELOG.md

# Testler sdist'ten de çalışabilsin: conftest.py olmadan test dosyaları import edilemiyor.
recursive-include tests *.py
recursive-include examples *.py
include examples/README.md
recursive-include tools *.py

# Dokümantasyon görselleri depoda duruyor, pakete girmiyor (README mutlak URL kullanıyor).
prune docs
prune .github
